# Groq API Key for LLM Extraction and Explanation
GROQ_API_KEY=GROQ_API_KEY

# Database Configuration (SQLite default, swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./claims.db

# CORS Config (comma separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Environment
ENVIRONMENT=development
PORT=8000
